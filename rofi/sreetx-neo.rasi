configuration {
    hover-select:        true;
    me-select-entry:     "MousePrimary";
    me-accept-entry:     "!MousePrimary";
}

* {
    /* Sesuaikan hex warna ini dengan palet Sreetx-Neo kamu */
    bg-color:            rgba(15, 15, 20, 0.75); /* Dark semi-transparan */
    bg-alt:              rgba(30, 30, 40, 0.6);
    fg-color:            #E0E0E8;                /* Teks utama terang */
    accent-color:        #86AAEC;                /* Warna aksen (biru/neon bawaanmu) */
    border-color:        rgba(134, 170, 236, 0.3);

    background-color:    transparent;
    text-color:          @fg-color;
    margin:              0;
    padding:             0;
}

window {
    width:               35%;
    transparency:        "real";
    background-color:    @bg-color;
    border:              2px;
    border-color:        @accent-color;
    border-radius:       12px; /* Matching sama roundness Hyprland-mu */
    padding:             20px;
}

mainbox {
    children:            [ inputbar, listview ];
    spacing:             15px;
}

inputbar {
    background-color:    @bg-alt;
    border-radius:       8px;
    padding:             10px 15px;
    children:            [ prompt, entry ];
}

prompt {
    text-color:          @accent-color;
    margin:              0px 10px 0px 0px;
}

entry {
    placeholder:         "Search...";
    placeholder-color:   rgba(224, 224, 232, 0.4);
}

listview {
    fixed-height:        false;
    dynamic:             true;
    lines:               8;
    columns:             1;
    spacing:             5px;
}

element {
    padding:             8px 12px;
    border-radius:       6px;
}

element selected {
    background-color:    @accent-color;
    text-color:          #0F0F14; /* Teks jadi gelap pas dipilih biar kontras */
}

element-text {
    vertical-align:      0.5;
    text-color:          inherit;
}

